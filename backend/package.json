{
  "name": "feedants-backend",
  "version": "1.0.0",
  "description": "Feedants Competition Details API — Node.js + Express + MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seeds/seed.js",
    "test": "npm run test:unit && npm run test:full",
    "test:unit": "jest tests/unit --forceExit",
    "test:full": "node tests/fullSuite.js",
    "test:smoke": "node tests/smoke.js",
    "test:integration": "jest tests/integration --runInBand --forceExit --detectOpenHandles",
    "test:concurrency": "jest tests/concurrency --runInBand --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand --forceExit --detectOpenHandles"
  },
  "keywords": [
    "feedants",
    "competition",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
